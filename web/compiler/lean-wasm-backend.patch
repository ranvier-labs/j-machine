+private def isCachedConstant (decl : Decl) : Bool :=
+  decl.params.isEmpty && decl.resultType.isObj
+
+-- IR references to closed terms borrow a persistent value. Re-evaluating a
+-- closed term on every reference leaks the reference retained by the caller's
+-- ownership convention (notably Nat.reprArray during compiler diagnostics).
+private partial def cacheConstantReturns (address : Instr) (scratch mark : Nat)
+    (code : Array Instr) : Array Instr :=
+  code.flatMap fun instr => match instr with
+    | .«return» => #[.localSet scratch, .localGet scratch, .call mark mark,
+        address, .localGet scratch, .i32Store 2 0, .localGet scratch, .«return»]
+    | .block ty body => #[.block ty (cacheConstantReturns address scratch mark body)]
+    | .loop ty body => #[.loop ty (cacheConstantReturns address scratch mark body)]
+    | .«if» ty yes no => #[.«if» ty (cacheConstantReturns address scratch mark yes)
+        (cacheConstantReturns address scratch mark no)]
+    | other => #[other]
+
